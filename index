<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CHICHO — Lotería</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
<style>
:root {
  --gold: #FFD700;
  --gold2: #FFA500;
  --dark: #0A0A0F;
  --blue: #0044BB;
  --blue2: #003087;
  --glass: rgba(255,255,255,0.05);
  --glass-border: rgba(255,215,0,0.2);
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: 'Outfit', sans-serif;
  background: var(--dark);
  min-height: 100vh;
  overflow-x: hidden;
  color: #fff;
}

/* ── FONDO ANIMADO ── */
.bg {
  position: fixed;
  inset: 0;
  z-index: 0;
  background:
    radial-gradient(ellipse 80% 60% at 50% -20%, rgba(0,68,187,0.5) 0%, transparent 70%),
    radial-gradient(ellipse 60% 40% at 80% 80%, rgba(255,165,0,0.12) 0%, transparent 60%),
    radial-gradient(ellipse 50% 50% at 10% 60%, rgba(0,48,135,0.3) 0%, transparent 60%),
    #0A0A0F;
}

.bg::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    repeating-linear-gradient(0deg, transparent, transparent 60px, rgba(255,215,0,0.03) 60px, rgba(255,215,0,0.03) 61px),
    repeating-linear-gradient(90deg, transparent, transparent 60px, rgba(255,215,0,0.03) 60px, rgba(255,215,0,0.03) 61px);
}

/* ── PARTÍCULAS ── */
.particles {
  position: fixed;
  inset: 0;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
}
.p {
  position: absolute;
  border-radius: 50%;
  animation: float linear infinite;
}
@keyframes float {
  0% { transform: translateY(100vh) rotate(0deg); opacity: 0; }
  10% { opacity: 1; }
  90% { opacity: 1; }
  100% { transform: translateY(-100px) rotate(720deg); opacity: 0; }
}

/* ── LANDING ── */
.landing {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40px 20px;
}

/* LOGO CHICHO */
.logo-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  cursor: pointer;
  transition: transform 0.3s;
  margin-bottom: 60px;
  animation: fadeDown 0.8s ease both;
}
.logo-wrap:hover { transform: scale(1.05); }
.logo-wrap:active { transform: scale(0.97); }

@keyframes fadeDown {
  from { opacity: 0; transform: translateY(-30px); }
  to { opacity: 1; transform: translateY(0); }
}

.logo-ring {
  width: 200px;
  height: 200px;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, rgba(255,215,0,0.15), transparent 60%),
              conic-gradient(from 0deg, var(--gold), var(--gold2), #fff8dc, var(--gold), var(--gold2), var(--gold));
  padding: 3px;
  position: relative;
  box-shadow:
    0 0 40px rgba(255,215,0,0.4),
    0 0 80px rgba(255,215,0,0.15),
    0 20px 60px rgba(0,0,0,0.5);
  animation: spin 8s linear infinite;
}
@keyframes spin {
  from { filter: hue-rotate(0deg); }
  to { filter: hue-rotate(30deg); }
}

.logo-inner {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: radial-gradient(circle at 40% 30%, #1a2a6c, #0a0a1a);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.logo-inner::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: conic-gradient(from 0deg, transparent 0%, rgba(255,215,0,0.05) 30%, transparent 60%);
  animation: shimmer 3s linear infinite;
}
@keyframes shimmer {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.logo-text {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 64px;
  line-height: 1;
  background: linear-gradient(135deg, #FFD700, #FFA500, #FFE566, #FFD700);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  letter-spacing: 4px;
  position: relative;
  z-index: 1;
  text-shadow: none;
  filter: drop-shadow(0 0 20px rgba(255,215,0,0.5));
}

.logo-sub {
  font-size: 10px;
  letter-spacing: 3px;
  color: rgba(255,215,0,0.6);
  text-transform: uppercase;
  position: relative;
  z-index: 1;
  margin-top: -4px;
}

.logo-tagline {
  margin-top: 20px;
  font-size: 13px;
  color: rgba(255,255,255,0.4);
  letter-spacing: 2px;
  text-transform: uppercase;
}

.logo-cta {
  margin-top: 12px;
  font-size: 16px;
  color: var(--gold);
  opacity: 0.7;
  letter-spacing: 1px;
  animation: pulse 2s ease-in-out infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}

/* BOTONES */
.btns {
  display: flex;
  flex-direction: column;
  gap: 14px;
  width: 100%;
  max-width: 320px;
  animation: fadeUp 0.8s 0.3s ease both;
}
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(30px); }
  to { opacity: 1; transform: translateY(0); }
}

.btn-jugar {
  width: 100%;
  height: 56px;
  background: linear-gradient(135deg, var(--blue), var(--blue2));
  border: 1px solid rgba(255,215,0,0.3);
  border-radius: 12px;
  color: #fff;
  font-family: 'Outfit', sans-serif;
  font-size: 15px;
  font-weight: 600;
  letter-spacing: 1px;
  cursor: pointer;
  transition: all 0.2s;
  position: relative;
  overflow: hidden;
}
.btn-jugar::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(255,215,0,0.1), transparent);
  opacity: 0;
  transition: opacity 0.2s;
}
.btn-jugar:hover { transform: translateY(-2px); box-shadow: 0 8px 30px rgba(0,68,187,0.4); }
.btn-jugar:hover::before { opacity: 1; }

.btn-admin {
  width: 100%;
  height: 56px;
  background: rgba(255,215,0,0.08);
  border: 1px solid rgba(255,215,0,0.4);
  border-radius: 12px;
  color: var(--gold);
  font-family: 'Outfit', sans-serif;
  font-size: 15px;
  font-weight: 600;
  letter-spacing: 1px;
  cursor: pointer;
  transition: all 0.2s;
  backdrop-filter: blur(10px);
}
.btn-admin:hover {
  background: rgba(255,215,0,0.15);
  transform: translateY(-2px);
  box-shadow: 0 8px 30px rgba(255,215,0,0.15);
}

.footer-land {
  position: absolute;
  bottom: 20px;
  font-size: 10px;
  color: rgba(255,255,255,0.2);
  letter-spacing: 1px;
}

/* ── MODAL LOGIN ── */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.85);
  backdrop-filter: blur(8px);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}
.modal-overlay.open {
  opacity: 1;
  pointer-events: all;
}

.modal-box {
  background: linear-gradient(135deg, #111122, #0d0d20);
  border: 1px solid var(--glass-border);
  border-radius: 20px;
  padding: 40px 32px;
  width: 90%;
  max-width: 360px;
  box-shadow: 0 30px 80px rgba(0,0,0,0.6), 0 0 0 1px rgba(255,215,0,0.1);
  transform: scale(0.9) translateY(20px);
  transition: transform 0.3s;
}
.modal-overlay.open .modal-box {
  transform: scale(1) translateY(0);
}

.modal-title {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 32px;
  letter-spacing: 3px;
  background: linear-gradient(135deg, var(--gold), var(--gold2));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 8px;
}
.modal-sub {
  font-size: 12px;
  color: rgba(255,255,255,0.3);
  margin-bottom: 28px;
  letter-spacing: 1px;
}

.modal-input {
  width: 100%;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 10px;
  padding: 14px 16px;
  color: #fff;
  font-family: 'Outfit', sans-serif;
  font-size: 20px;
  letter-spacing: 6px;
  text-align: center;
  outline: none;
  margin-bottom: 16px;
  transition: border-color 0.2s;
}
.modal-input:focus { border-color: var(--gold); }
.modal-input::placeholder { letter-spacing: 2px; font-size: 14px; color: rgba(255,255,255,0.2); }

.modal-err {
  color: #ff4444;
  font-size: 12px;
  text-align: center;
  margin-bottom: 12px;
  min-height: 16px;
}

.modal-btn {
  width: 100%;
  height: 50px;
  background: linear-gradient(135deg, var(--gold), var(--gold2));
  border: none;
  border-radius: 10px;
  color: #0a0a0f;
  font-family: 'Outfit', sans-serif;
  font-size: 15px;
  font-weight: 700;
  letter-spacing: 2px;
  cursor: pointer;
  transition: all 0.2s;
}
.modal-btn:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(255,215,0,0.3); }

.modal-close {
  width: 100%;
  height: 40px;
  background: transparent;
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 10px;
  color: rgba(255,255,255,0.3);
  font-family: 'Outfit', sans-serif;
  font-size: 13px;
  cursor: pointer;
  margin-top: 10px;
  transition: all 0.2s;
}
.modal-close:hover { border-color: rgba(255,255,255,0.3); color: rgba(255,255,255,0.6); }

/* ── DASHBOARD ── */
.dashboard {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 50;
  background: #0d0d1a;
  overflow-y: auto;
}
.dashboard.open { display: block; }

.dash-header {
  background: linear-gradient(135deg, #111130, #0d0d20);
  border-bottom: 1px solid rgba(255,215,0,0.15);
  padding: 20px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: sticky;
  top: 0;
  z-index: 10;
  backdrop-filter: blur(20px);
}
.dash-title {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 28px;
  letter-spacing: 3px;
  background: linear-gradient(135deg, var(--gold), var(--gold2));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.dash-sub { font-size: 11px; color: rgba(255,255,255,0.3); letter-spacing: 1px; }
.btn-cerrar {
  background: rgba(255,68,68,0.1);
  border: 1px solid rgba(255,68,68,0.3);
  border-radius: 8px;
  color: #ff4444;
  font-family: 'Outfit', sans-serif;
  font-size: 12px;
  padding: 8px 16px;
  cursor: pointer;
  transition: all 0.2s;
}
.btn-cerrar:hover { background: rgba(255,68,68,0.2); }

/* STATS */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
  padding: 20px 16px 0;
}
.stat-card {
  background: linear-gradient(135deg, rgba(255,255,255,0.04), rgba(255,255,255,0.01));
  border: 1px solid rgba(255,215,0,0.1);
  border-radius: 14px;
  padding: 18px 16px;
}
.stat-label { font-size: 10px; color: rgba(255,255,255,0.3); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 6px; }
.stat-val { font-family: 'Bebas Neue', sans-serif; font-size: 32px; color: var(--gold); letter-spacing: 2px; }
.stat-val.blue { color: #4488ff; }
.stat-val.green { color: #44ff88; }
.stat-val.orange { color: #ff8844; }

/* FILTROS */
.filtros {
  display: flex;
  gap: 8px;
  padding: 16px 16px 0;
  flex-wrap: wrap;
}
.filtro-btn {
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 20px;
  color: rgba(255,255,255,0.5);
  font-family: 'Outfit', sans-serif;
  font-size: 11px;
  padding: 6px 14px;
  cursor: pointer;
  transition: all 0.2s;
}
.filtro-btn.active {
  background: rgba(255,215,0,0.12);
  border-color: rgba(255,215,0,0.4);
  color: var(--gold);
}

.dash-search {
  margin: 12px 16px 0;
  width: calc(100% - 32px);
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 10px;
  padding: 12px 16px;
  color: #fff;
  font-family: 'Outfit', sans-serif;
  font-size: 13px;
  outline: none;
}
.dash-search:focus { border-color: rgba(255,215,0,0.3); }
.dash-search::placeholder { color: rgba(255,255,255,0.2); }

/* JUGADAS */
.jugadas-list { padding: 16px; display: flex; flex-direction: column; gap: 12px; }

.jcard {
  background: linear-gradient(135deg, rgba(255,255,255,0.04), rgba(255,255,255,0.01));
  border: 1px solid rgba(255,255,255,0.07);
  border-radius: 14px;
  padding: 16px;
  transition: border-color 0.2s;
}
.jcard:hover { border-color: rgba(255,215,0,0.2); }

.jcard-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 10px;
}
.jcard-nombre { font-size: 17px; font-weight: 700; color: #fff; }
.jcard-fecha { font-size: 10px; color: rgba(255,255,255,0.3); margin-top: 2px; }

.badge {
  font-size: 10px;
  font-weight: 600;
  padding: 3px 10px;
  border-radius: 20px;
  letter-spacing: 1px;
  text-transform: uppercase;
}
.badge-pend { background: rgba(255,136,68,0.15); color: #ff8844; border: 1px solid rgba(255,136,68,0.3); }
.badge-pag { background: rgba(68,255,136,0.15); color: #44ff88; border: 1px solid rgba(68,255,136,0.3); }

.jcard-nums {
  display: flex;
  gap: 5px;
  flex-wrap: wrap;
  margin-bottom: 10px;
}
.jnum {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--blue), var(--blue2));
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.jcard-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.jcard-modal { font-size: 11px; color: rgba(255,255,255,0.3); }
.jcard-total { font-family: 'Bebas Neue', sans-serif; font-size: 22px; color: var(--gold); letter-spacing: 1px; }

.jcard-actions { display: flex; gap: 6px; margin-top: 10px; }
.jbtn {
  flex: 1;
  height: 32px;
  border-radius: 8px;
  font-family: 'Outfit', sans-serif;
  font-size: 11px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
  border: none;
}
.jbtn-pag { background: rgba(68,255,136,0.1); color: #44ff88; border: 1px solid rgba(68,255,136,0.2); }
.jbtn-pag:hover { background: rgba(68,255,136,0.2); }
.jbtn-del { background: rgba(255,68,68,0.1); color: #ff4444; border: 1px solid rgba(255,68,68,0.2); }
.jbtn-del:hover { background: rgba(255,68,68,0.2); }

.dash-empty {
  text-align: center;
  padding: 60px 20px;
  color: rgba(255,255,255,0.2);
  font-size: 14px;
  line-height: 1.8;
}

.dash-footer {
  padding: 16px;
  display: flex;
  justify-content: flex-end;
}
.btn-borrar-todo {
  background: rgba(255,68,68,0.08);
  border: 1px solid rgba(255,68,68,0.2);
  border-radius: 8px;
  color: rgba(255,68,68,0.6);
  font-family: 'Outfit', sans-serif;
  font-size: 12px;
  padding: 8px 16px;
  cursor: pointer;
  transition: all 0.2s;
}
.btn-borrar-todo:hover { background: rgba(255,68,68,0.15); color: #ff4444; }
</style>
</head>
<body>

<!-- FONDO -->
<div class="bg"></div>
<div class="particles" id="particles"></div>

<!-- ===== LANDING ===== -->
<div class="landing" id="landing">

  <!-- LOGO CHICHO -->
  <div class="logo-wrap" onclick="abrirQuini()" title="Ir a Quini 6">
    <div class="logo-ring">
      <div class="logo-inner">
        <div class="logo-text">CHICHO</div>
        <div class="logo-sub">Lotería</div>
      </div>
    </div>
    <div class="logo-tagline">Sistema de Jugadas</div>
    <div class="logo-cta">▼ Tocá para jugar</div>
  </div>

  <!-- BOTONES -->
  <div class="btns">
    <button class="btn-admin" onclick="abrirLoginModal()">
      🔒 &nbsp; PANEL ADMIN
    </button>
  </div>

  <div class="footer-land">© CHICHO LOTERÍA — Sistema de Gestión</div>
</div>

<!-- ===== MODAL LOGIN ===== -->
<div class="modal-overlay" id="modal-login">
  <div class="modal-box">
    <div class="modal-title">ADMIN</div>
    <div class="modal-sub">ACCESO RESTRINGIDO</div>
    <input
      class="modal-input"
      type="password"
      id="inp-pass"
      placeholder="Contraseña"
      maxlength="8"
      onkeydown="if(event.key==='Enter'){loginCheck();}"
    >
    <div class="modal-err" id="login-err"></div>
    <button class="modal-btn" onclick="loginCheck()">INGRESAR</button>
    <button class="modal-close" onclick="cerrarLogin()">Cancelar</button>
  </div>
</div>

<!-- ===== DASHBOARD ===== -->
<div class="dashboard" id="dashboard">

  <div class="dash-header">
    <div>
      <div class="dash-title">DASHBOARD</div>
      <div class="dash-sub">REGISTRO DE JUGADAS</div>
    </div>
    <button class="btn-cerrar" onclick="cerrarDash()">✕ Salir</button>
  </div>

  <!-- STATS -->
  <div class="stats-grid" id="stats-grid">
    <div class="stat-card">
      <div class="stat-label">Total Jugadas</div>
      <div class="stat-val blue" id="st-total">0</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Recaudado</div>
      <div class="stat-val green" id="st-monto">$0</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Pendientes</div>
      <div class="stat-val orange" id="st-pend">0</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Pagados</div>
      <div class="stat-val" id="st-pag">0</div>
    </div>
  </div>

  <!-- FILTROS -->
  <div class="filtros">
    <button class="filtro-btn active" onclick="setFiltro('todos',this)">Todos</button>
    <button class="filtro-btn" onclick="setFiltro('pendiente',this)">Pendientes</button>
    <button class="filtro-btn" onclick="setFiltro('pagado',this)">Pagados</button>
  </div>

  <!-- BUSCADOR -->
  <input class="dash-search" type="text" id="dash-search" placeholder="🔍 Buscar por nombre..." oninput="renderJugadas()">

  <!-- LISTA -->
  <div class="jugadas-list" id="jugadas-list"></div>

  <!-- FOOTER -->
  <div class="dash-footer">
    <button class="btn-borrar-todo" onclick="borrarTodo()">🗑 Borrar todo el registro</button>
  </div>

</div>

<script>
var filtroActual = "todos";

/* ── PARTÍCULAS ── */
(function() {
  var container = document.getElementById("particles");
  var colors = ["rgba(255,215,0,0.4)","rgba(255,165,0,0.3)","rgba(0,68,187,0.4)","rgba(255,255,255,0.2)"];
  for (var i = 0; i < 20; i++) {
    (function() {
      var p = document.createElement("div");
      p.className = "p";
      var size = Math.random() * 4 + 1;
      p.style.cssText = [
        "width:" + size + "px",
        "height:" + size + "px",
        "left:" + Math.random()*100 + "%",
        "background:" + colors[Math.floor(Math.random()*colors.length)],
        "animation-duration:" + (Math.random()*15+10) + "s",
        "animation-delay:" + (Math.random()*15) + "s"
      ].join(";");
      container.appendChild(p);
    })();
  }
})();

/* ── NAVEGACIÓN ── */
function abrirQuini() {
  window.open("quini6-5.html", "_blank");
}

function abrirLoginModal() {
  document.getElementById("modal-login").classList.add("open");
  document.getElementById("inp-pass").value = "";
  document.getElementById("login-err").textContent = "";
  setTimeout(function() { document.getElementById("inp-pass").focus(); }, 300);
}

function cerrarLogin() {
  document.getElementById("modal-login").classList.remove("open");
}

function loginCheck() {
  var pass = document.getElementById("inp-pass").value;
  if (pass === "1234") {
    cerrarLogin();
    abrirDash();
  } else {
    document.getElementById("login-err").textContent = "Contraseña incorrecta";
    document.getElementById("inp-pass").value = "";
    document.getElementById("inp-pass").focus();
  }
}

/* ── DASHBOARD ── */
function abrirDash() {
  document.getElementById("dashboard").classList.add("open");
  actualizarStats();
  renderJugadas();
}

function cerrarDash() {
  document.getElementById("dashboard").classList.remove("open");
}

function setFiltro(f, btn) {
  filtroActual = f;
  document.querySelectorAll(".filtro-btn").forEach(function(b) { b.classList.remove("active"); });
  btn.classList.add("active");
  renderJugadas();
}

/* ── DATA ── */
function loadPedidos() {
  try {
    var d = localStorage.getItem("q6v2");
    return d ? JSON.parse(d) : [];
  } catch(e) { return []; }
}

function savePedidos(lista) {
  try { localStorage.setItem("q6v2", JSON.stringify(lista)); } catch(e) {}
}

function actualizarStats() {
  var lista = loadPedidos();
  var pagados = lista.filter(function(p) { return p.estado === "pagado"; });
  var pendientes = lista.filter(function(p) { return p.estado !== "pagado"; });
  var totalMonto = pagados.reduce(function(s, p) { return s + p.total; }, 0);

  document.getElementById("st-total").textContent = lista.length;
  document.getElementById("st-monto").textContent = "$" + totalMonto.toLocaleString("es-AR");
  document.getElementById("st-pend").textContent = pendientes.length;
  document.getElementById("st-pag").textContent = pagados.length;
}

function renderJugadas() {
  var lista = loadPedidos();
  var busqueda = document.getElementById("dash-search").value.toLowerCase();

  // Filtrar
  lista = lista.filter(function(p) {
    if (filtroActual !== "todos" && p.estado !== filtroActual) { return false; }
    if (busqueda) {
      var nombre = (p.nombre + " " + p.apellido).toLowerCase();
      if (nombre.indexOf(busqueda) < 0) { return false; }
    }
    return true;
  });

  var c = document.getElementById("jugadas-list");
  if (!lista.length) {
    c.innerHTML = "<div class='dash-empty'>No hay jugadas para mostrar.<br>Las jugadas aparecen aquí después de completar el formulario.</div>";
    actualizarStats();
    return;
  }

  var h = "";
  for (var i = 0; i < lista.length; i++) {
    var p = lista[i];
    var esPagado = p.estado === "pagado";
    var badgeClass = esPagado ? "badge badge-pag" : "badge badge-pend";
    var badgeText = esPagado ? "✓ PAGADO" : "⏳ PENDIENTE";

    var nums = "";
    for (var j = 0; j < p.numeros.length; j++) {
      nums += "<div class='jnum'>" + p.numeros[j] + "</div>";
    }

    h += "<div class='jcard' id='card-" + p.id + "'>";
    h += "<div class='jcard-top'>";
    h += "<div><div class='jcard-nombre'>" + p.nombre + " " + p.apellido + "</div>";
    h += "<div class='jcard-fecha'>📅 " + p.fecha + "</div></div>";
    h += "<span class='" + badgeClass + "'>" + badgeText + "</span>";
    h += "</div>";
    h += "<div class='jcard-nums'>" + nums + "</div>";
    h += "<div class='jcard-bottom'>";
    h += "<div class='jcard-modal'>🎰 " + p.modalidades + "</div>";
    h += "<div class='jcard-total'>$ " + p.total.toLocaleString("es-AR") + "</div>";
    h += "</div>";
    h += "<div class='jcard-actions'>";
    if (!esPagado) {
      h += "<button class='jbtn jbtn-pag' onclick='marcarPagado(" + p.id + ")'>✓ Marcar Pagado</button>";
    } else {
      h += "<button class='jbtn jbtn-pag' onclick='marcarPendiente(" + p.id + ")' style='opacity:0.5'>↩ Pendiente</button>";
    }
    h += "<button class='jbtn jbtn-del' onclick='eliminarJugada(" + p.id + ")'>🗑 Eliminar</button>";
    h += "</div>";
    h += "</div>";
  }
  c.innerHTML = h;
  actualizarStats();
}

function marcarPagado(id) {
  var lista = loadPedidos();
  for (var i = 0; i < lista.length; i++) {
    if (lista[i].id == id) { lista[i].estado = "pagado"; break; }
  }
  savePedidos(lista);
  renderJugadas();
}

function marcarPendiente(id) {
  var lista = loadPedidos();
  for (var i = 0; i < lista.length; i++) {
    if (lista[i].id == id) { lista[i].estado = "pendiente"; break; }
  }
  savePedidos(lista);
  renderJugadas();
}

function eliminarJugada(id) {
  if (!confirm("Eliminar esta jugada?")) { return; }
  var lista = loadPedidos().filter(function(p) { return p.id != id; });
  savePedidos(lista);
  renderJugadas();
}

function borrarTodo() {
  if (!confirm("Borrar TODAS las jugadas del registro?")) { return; }
  try { localStorage.removeItem("q6v2"); } catch(e) {}
  renderJugadas();
}

